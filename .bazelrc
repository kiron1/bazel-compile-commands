#
# .bazelrc
#

startup --windows_enable_symlinks

common --verbose_failures
common --incompatible_strict_action_env

build --ui_event_filters=-info
build --enable_runfiles

build:cl --cxxopt=/std:c++17
build:gnu --cxxopt=-std=c++17

# Fail instead of silently falling back to a host C++ toolchain.
build:gnu --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

# Hermetic clang-cl, MSVC runtime and Windows SDK from @llvm. Using the
# Microsoft payloads requires accepting their licenses.
build:cl --platforms=@llvm//platforms:windows_x86_64_msvc
build:cl --repo_env=BAZEL_MSVC_RUNTIME_VISUAL_STUDIO_EULA=1
build:cl --repo_env=BAZEL_WINDOWS_SDK_EULA=1

# Disable Boost's MSVC auto-link pragma; Bazel handles linking explicitly.
build:cl --cxxopt=-DBOOST_ALL_NO_LIB

# io_bazel's generated protobufs contain a field named 'environ', which MSVC CRT
# turns into a macro. Suppress POSIX CRT name aliases only for io_bazel source files.
build:cl --per_file_copt=.*io_bazel.*@/D_CRT_DECLARE_NONSTDC_NAMES=0

build:gnu --copt=-pedantic
build:gnu --copt=-Wall
build:gnu --copt=-Wextra

build:release --compilation_mode=opt

build:ci --show_timestamps
build:ci --curses=no

test --test_output=errors
test --test_env=HOME

# allow workspace specific user settings
try-import %workspace%/user.bazelrc
